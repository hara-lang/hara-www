{
  "name": "@hara-lang/www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prepare:visual-language": "node scripts/prepare-visual-language.mjs",
    "prepare:benchmarks": "node scripts/prepare-benchmark-homepage.mjs",
    "check": "npm run prepare:visual-language && npm run prepare:benchmarks && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run prepare:visual-language && npm run prepare:benchmarks && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test": "node --test test/*.test.mjs packages/live/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@hara-lang/live": "file:packages/live",
    "@hara-lang/web-editor": "file:vendor/hara-ui/packages/web-editor",
    "@hara-lang/web-runtime": "file:vendor/hara-ui/packages/web-runtime",
    "@hara-lang/visual-language": "file:packages/visual-language",
    "astro": "^5.16.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22" }
}
