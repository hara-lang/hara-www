{
  "name": "@hara-lang/www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prepare:docs-import": "node scripts/import-docs.mjs",
    "verify:docs-import": "node scripts/import-docs.mjs --check",
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "prepare:benchmarks": "node scripts/prepare-benchmark-homepage.mjs",
    "check": "npm run verify:docs-import && npm run prepare:ui && npm run prepare:benchmarks && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run verify:docs-import && npm run prepare:ui && npm run prepare:benchmarks && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test": "node --test test/*.test.mjs packages/live/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@hara-lang/live": "file:packages/live",
    "@hara-lang/web-editor": "file:vendor/hara-ui/packages/web-editor",
    "@hara-lang/web-runtime": "file:vendor/hara-ui/packages/web-runtime",
    "@hara-lang/ui": "file:../../technology/hara-ui",
    "@hara-lang/ui-astro": "file:../../technology/hara-ui/packages/ui-astro",
    "@hara-lang/ui-tool": "file:../../technology/hara-ui/packages/ui-tool",
    "astro": "^5.16.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22" }
}
