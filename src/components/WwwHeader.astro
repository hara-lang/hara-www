---
import ThemeToggle from "@hara-lang/ui-astro/astro/ThemeToggle.astro";
import V2Header from "@hara-lang/ui-astro/astro/v2/Header.astro";

type NavItem = {
  href: string;
  label: string;
  external?: boolean;
};

const { nav = [] as NavItem[] } = Astro.props;
---
<V2Header
  class="hara-www-header"
  homeHref="https://hara-lang.org/"
  nav={nav}
  activePath={Astro.url.pathname}
  label="Hara WWW"
  variant="product"
  accountHref="https://id.hara-lang.org/"
>
  <ThemeToggle />
  <div class="hara-www-identity" data-hara-identity></div>
</V2Header>
