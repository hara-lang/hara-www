---
const communityLinks = [
  { label: "Hara Learn", detail: "Posts, people, and projects", href: "https://learn.hara-lang.org/" },
  { label: "Hara on GitHub", detail: "Code, issues, and proposals", href: "https://github.com/hara-lang/hara" },
  { label: "Hara blog", detail: "A slower weekly read", href: "/blog/" }
];

const clojureLinks = [
  { label: "Clojure Q&A", href: "https://ask.clojure.org/" },
  { label: "ClojureVerse", href: "https://clojureverse.org/" },
  { label: "User groups", href: "https://clojure.org/community/user_groups" }
];
---
<section class="www-v2-section www-v2-connect" id="community" aria-labelledby="www-v2-community-title">
  <header class="www-v2-section-head">
    <div>
      <p class="hara-v2-kicker">Hara · community</p>
      <h2 id="www-v2-community-title">See what people are making.</h2>
    </div>
    <p>Hara is open source and still becoming. Conversation is part of the language.</p>
  </header>

  <div class="www-v2-connect__grid">
    <article class="www-v2-community-card www-v2-community-card--world">
      <p class="hara-v2-kicker">The Hara community</p>
      <h3>Read what is happening.</h3>
      <p>Follow the project, meet the people, and add your own work when you are ready.</p>
      <div class="www-v2-link-list">
        {communityLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            <span><strong>{link.label}</strong><small>{link.detail}</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </article>

    <article class="www-v2-community-card">
      <p class="hara-v2-kicker">The wider Lisp conversation</p>
      <h3>What are people saying about Clojure?</h3>
      <p>Hara shares a family resemblance with Clojure. These are good places to listen to the questions, practices, and debates around it.</p>
      <div class="www-v2-link-list">
        {clojureLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            <span><strong>{link.label}</strong></span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </article>

    <form class="www-v2-poll" data-hara-poll data-poll-key="hara-www-home-v1">
      <div>
        <p class="hara-v2-kicker">Quick poll</p>
        <h3>What brought you here?</h3>
      </div>
      <div class="www-v2-poll__options" role="group" aria-label="What brought you here?">
        <button type="button" data-poll-option="learn">I want to learn</button>
        <button type="button" data-poll-option="make">I want to make</button>
        <button type="button" data-poll-option="connect">I want to connect</button>
      </div>
      <p class="www-v2-poll__status" data-poll-status>One tap. Saved only in this browser.</p>
    </form>
  </div>

  <footer class="www-v2-connect__footer">
    <a class="hara-v2-button" data-variant="primary" href="https://learn.hara-lang.org/post">Write a post <span aria-hidden="true">↗</span></a>
    <a class="hara-v2-button" href="https://github.com/hara-lang/hara">Open source <span aria-hidden="true">↗</span></a>
  </footer>

  <script>
    const initialisePoll = () => {
      document.querySelectorAll("[data-hara-poll]").forEach((poll) => {
        if (!(poll instanceof HTMLElement) || poll.dataset.ready === "true") return;
        poll.dataset.ready = "true";
        const key = poll.dataset.pollKey ?? "hara-www-poll";
        const status = poll.querySelector("[data-poll-status]");
        const options = [...poll.querySelectorAll("[data-poll-option]")];
        const labels: Record<string, string> = { learn: "learning", make: "making", connect: "connecting" };

        const select = (value: string, announce = true) => {
          options.forEach((option) => option.setAttribute("aria-pressed", String(option.getAttribute("data-poll-option") === value)));
          if (announce && status) status.textContent = `Thanks — ${labels[value] ?? value} is your answer on this device.`;
        };

        let saved = null;
        try { saved = localStorage.getItem(key); } catch {}
        if (saved) select(saved, false);

        options.forEach((option) => option.addEventListener("click", () => {
          const value = option.getAttribute("data-poll-option") ?? "";
          try { localStorage.setItem(key, value); } catch {}
          select(value);
        }));
      });
    };

    initialisePoll();
    document.addEventListener("astro:page-load", initialisePoll);
  </script>
</section>
