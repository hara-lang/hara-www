<script>
  import { mountLiveCard } from "@hara-lang/live";
  import { createLiveKernel } from "@hara-lang/live/kernel";
  import { PONG_SOURCE } from "@hara-lang/live/pong";

  const runtimeResources = {
    "studio.store": "/runtime/studio/hal/store.hal",
    "studio.fs": "/runtime/studio/hal/fs.hal",
    "studio.node": "/runtime/studio/hal/node.hal",
    "studio.draw": "/runtime/studio/hal/draw.hal",
    "std.substrate.core": "/runtime/std/substrate/core.hal",
    "std.substrate.frame": "/runtime/std/substrate/frame.hal",
    "std.substrate.json": "/runtime/std/substrate/json.hal",
    "std.substrate.protocol": "/runtime/std/substrate/protocol.hal",
    "std.substrate.pubsub": "/runtime/std/substrate/pubsub.hal",
    "std.substrate.request": "/runtime/std/substrate/request.hal",
    "std.substrate.router": "/runtime/std/substrate/router.hal",
    "std.substrate.space": "/runtime/std/substrate/space.hal",
    "std.substrate.transport-memory": "/runtime/std/substrate/transport_memory.hal",
    "std.substrate.util": "/runtime/std/substrate/util.hal",
    "std.substrate.util-handlers": "/runtime/std/substrate/util_handlers.hal",
    "std.substrate": "/runtime/std/substrate.hal"
  };
  let browserKernelPromise: ReturnType<typeof createLiveKernel> | null = null;
  const browserKernel = {
    async createSession(name: string, options: { filesystem?: string } = {}) {
      browserKernelPromise ??= createLiveKernel({
        runtimeBase: "/runtime",
        kernelModuleUrl: "/runtime/browser-kernel.js",
        resources: runtimeResources
      });
      const kernel = await browserKernelPromise;
      return kernel.createSession(name, options);
    },
    close() {
      void browserKernelPromise?.then((kernel) => kernel.close());
    }
  };

  const loadShaderSource = async () => {
    try {
      const response = await fetch("/sources/ocean.hal");
      return response.ok ? await response.text() : null;
    } catch {
      return null;
    }
  };

  const selectExample = (root: HTMLElement, id: string) => {
    [...root.querySelectorAll<HTMLButtonElement>("[data-snippet-id]")]
      .find((button) => button.dataset.snippetId === id)
      ?.click();
  };

  const initialisePlay = async () => {
    const shaderSource = await loadShaderSource();
    const playMount = document.querySelector<HTMLElement>("[data-live-play]");
    const shaderMount = document.querySelector<HTMLElement>("[data-live-shader-mount]");
    const selector = document.querySelector<HTMLSelectElement>("[data-live-example-select]");
    const playSnippets = [
      { id: "read", title: "Read", kind: "console" as const, source: `(+ 19 23)` },
      { id: "make", title: "Make", kind: "console" as const, source: `(def greeting "hello")

(str greeting ", Hara")` },
      { id: "compose", title: "Compose", kind: "console" as const, source: `(def scores [4 8 15 16 23 42])

(map (fn [score] (* score 2)) scores)` },
      { id: "animate", title: "Animate", kind: "canvas" as const, source: PONG_SOURCE },
      ...(shaderSource ? [{ id: "ocean", title: "Ocean shader", kind: "canvas" as const, source: shaderSource }] : [])
    ];

    if (!shaderSource) selector?.querySelector("option[value=\"ocean\"]")?.remove();

    if (playMount) {
      mountLiveCard(playMount, {
        snippets: playSnippets,
        activeSnippet: "read",
        kernel: browserKernel,
        runtimeBase: "/runtime"
      });
      selector?.addEventListener("change", () => selectExample(playMount, selector.value));
    }

    if (shaderMount) {
      const shaderCard = mountLiveCard(shaderMount, {
        snippets: [{
          id: "ocean",
          title: "Ocean shader",
          kind: "canvas" as const,
          source: shaderSource ?? PONG_SOURCE
        }],
        activeSnippet: "ocean",
        kernel: browserKernel,
        runtimeBase: "/runtime"
      });
      shaderMount.querySelector(".www-v2-shader-placeholder")?.remove();
      void shaderCard.run().catch(() => {});
    }
  };

  void initialisePlay();
</script>
