<section class="www-v2-section www-v2-play" id="play" aria-labelledby="www-v2-play-title">
  <header class="www-v2-play__hero">
    <div class="www-v2-play__copy">
      <p class="hara-v2-kicker">Hara · play</p>
      <h1 id="www-v2-play-title">Make something small.</h1>
      <p>Hara is a Lisp for learning, making, and sharing. Start with a form and see where it takes you.</p>
      <div class="www-v2-actions">
        <a class="hara-v2-button" data-variant="primary" href="https://playground.hara-lang.org/">Try Hara <span aria-hidden="true">→</span></a>
        <a class="hara-v2-button" href="/docs/">Read the docs</a>
      </div>
    </div>
    <div class="www-v2-play__gradient" aria-hidden="true">
      <span class="www-v2-play__gradient-orbit"></span>
      <span class="www-v2-play__gradient-orbit"></span>
      <span class="www-v2-play__gradient-label">(+ 2 3)</span>
    </div>
  </header>

  <article class="www-v2-play__console" aria-labelledby="www-v2-console-title">
    <header>
      <div>
        <p class="hara-v2-kicker">Try it here</p>
        <h2 id="www-v2-console-title">One expression.</h2>
      </div>
      <a href="https://playground.hara-lang.org/">Open the Playground <span aria-hidden="true">↗</span></a>
    </header>
    <div class="www-v2-play__mount" data-live-play></div>
    <noscript>
      <p class="www-v2-noscript">The editor needs JavaScript. The same example is waiting in the <a href="/docs/getting-started/playground/">Playground guide</a>.</p>
    </noscript>
  </article>
</section>
