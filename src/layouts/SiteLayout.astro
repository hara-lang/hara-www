---
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "@hara-lang/visual-language/v2.css";
import "../styles/site.css";
import "../styles/shell.css";
import "../styles/v2-adoption.css";
import "@hara-lang/visual-language/theme.js";

const {
  title = "Hara",
  description = "A small, high-performance Lisp for learning to build software from first principles.",
  image = "/og-hara.jpg",
  imageAlt = "Hara — simple to pick up, fast enough to keep"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const primaryNavigation = [
  { label: "Benchmarks", href: "/benchmarks/" },
  { label: "Docs", href: "/docs/" },
  { label: "Specs", href: "https://specs.hara-lang.org/" },
  { label: "World", href: "https://world.hara-lang.org/" }
];
const isCurrent = (href) => href.startsWith("/") && (currentPath === href || currentPath.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="hara-identity-mode" content="popup" />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/hara-favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/install-copy.css" />
    <link rel="stylesheet" href="/assets/live-surface.css" />
    <title>{title}</title>
    <script is:inline src="/assets/identity-loader.js" defer></script>
    <script is:inline src="/assets/install-copy.js" defer></script>
  </head>
  <body class="hara-v2 hara-www-site">
    <a class="site-skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" data-site-header data-navigation-open="false">
      <a class="brand" href="/" aria-label="Hara home"><HaraMark size={27} /><span>Hara</span></a>
      <nav id="site-primary-navigation" aria-label="Primary" data-site-navigation>
        {primaryNavigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <button
          class="site-navigation-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="site-primary-navigation"
          data-site-navigation-trigger
        >
          <span>Browse</span>
          <small>Hara</small>
          <i aria-hidden="true"></i>
        </button>
        <div data-hara-identity></div>
        <ThemeToggle />
      </div>
      <button class="site-navigation-backdrop" type="button" tabindex="-1" aria-label="Close navigation" data-site-navigation-backdrop hidden></button>
    </header>
    <div id="main-content" class="site-content-root" tabindex="-1">
      <slot />
    </div>
    <footer class="site-footer">
      <span>Hara</span>
      <p>Start simple. Build forever.</p>
      <p>
        <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/hara-lang/hara/blob/main/LICENSE">Apache-2.0</a>
      </p>
    </footer>

    <script>
      import { initialiseSiteNavigation } from "../scripts/site-navigation.js";
      initialiseSiteNavigation();
      document.addEventListener("astro:page-load", () => initialiseSiteNavigation());
    </script>
  </body>
</html>
