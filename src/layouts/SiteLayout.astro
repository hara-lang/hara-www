---
import V2ContextNav from "@hara-lang/visual-language/astro/v2/ContextNav.astro";
import V2Header from "@hara-lang/visual-language/astro/v2/Header.astro";
import V2Shell from "@hara-lang/visual-language/astro/v2/Shell.astro";
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import "@hara-lang/visual-language/v2.css";
import "../styles/site.css";
import "../styles/shell.css";
import "../styles/v2-adoption.css";
import "@hara-lang/visual-language/theme.js";

const {
  title = "Hara",
  description = "A small, high-performance Lisp for learning to build software from first principles.",
  image = "/og-hara.jpg",
  imageAlt = "Hara programming language — readable forms and explicit runtimes"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const activePath = Astro.url.pathname;
const primaryNavigation = [
  { label: "Benchmarks", href: "/benchmarks/" },
  { label: "Docs", href: "/docs/" },
  { label: "Specs", href: "https://specs.hara-lang.org/", external: true },
  { label: "World", href: "https://world.hara-lang.org/", external: true }
];
const familyNavigation = [
  { href: "/", label: "Home" },
  { href: "/docs/", label: "Docs" },
  { href: "/benchmarks/", label: "Benchmarks" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="hara-identity-mode" content="popup" />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/hara-favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/install-copy.css" />
    <link rel="stylesheet" href="/assets/live-surface.css" />
    <title>{title}</title>
    <script is:inline src="/assets/identity-loader.js" defer></script>
    <script is:inline src="/assets/install-copy.js" defer></script>
  </head>
  <body class="hara-v2 hara-www-site" data-hara-v2-site="www">
    <V2Shell sidebar={false} aside={false} class="hara-www-shell">
      <V2Header slot="header" section="WWW" nav={primaryNavigation} activePath={activePath}>
        <div data-hara-identity></div>
        <ThemeToggle />
      </V2Header>
      <V2ContextNav slot="context" items={familyNavigation} activePath={activePath} label="Hara WWW family" />
      <div class="hara-www-slot"><slot /></div>
      <footer slot="footer" class="site-footer">
        <span>Hara</span>
        <p>Programming language · forms, runtimes, libraries, and source records.</p>
        <p>
          <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/hara-lang/hara/blob/main/LICENSE">Apache-2.0</a>
        </p>
      </footer>
    </V2Shell>
  </body>
</html>
