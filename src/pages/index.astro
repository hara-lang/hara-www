---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeNavigation from "../components/home/HomeNavigation.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeFirstForm from "../components/home/HomeFirstForm.astro";
import HomeLanguage from "../components/home/HomeLanguage.astro";
import HomeRuntime from "../components/home/HomeRuntime.astro";
import HomeEvidenceStart from "../components/home/HomeEvidenceStart.astro";
import "@hara-lang/live/style.css";
import "../styles/home-interactions.css";
---
<SiteLayout
  title="Hara — readable forms and explicit runtimes"
