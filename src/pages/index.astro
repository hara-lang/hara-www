---
import SiteLayout from "../layouts/SiteLayout.astro";
import PlaySection from "../components/www-v2/PlaySection.astro";
import LearnSection from "../components/www-v2/LearnSection.astro";
import CommunitySection from "../components/www-v2/CommunitySection.astro";
import BuildSection from "../components/www-v2/BuildSection.astro";
import HomepageRuntime from "../components/www-v2/HomepageRuntime.astro";
import "@hara-lang/live/style.css";
import "../styles/www-v2.css";

const homepageSections = [
  { id: "play", label: "Play" },
  { id: "learn", label: "Learn" },
  { id: "community", label: "Community" },
  { id: "build", label: "Build" }
];
---
<SiteLayout
  title="Hara"
  description="Hara is a Lisp for making software, learning in public, and sharing the work."
  sections={homepageSections}
>
  <div class="www-v2-main">
    <PlaySection />
    <LearnSection />
    <CommunitySection />
    <BuildSection />
  </div>
  <HomepageRuntime />
</SiteLayout>
